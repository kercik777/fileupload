<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_surface"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Top badge icon -->
    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_danger_circle">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_trash"
            app:tint="@color/md_error" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvDeleteTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/history_delete_what_title"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
        android:textColor="@color/md_on_surface"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDeleteSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="@color/md_on_surface_variant"
        tools:text="«photo.jpg» загружен и для скачивания, и для просмотра" />

    <!-- Dual-mode choices container (visible when choosing between Download / Preview / Both) -->
    <LinearLayout
        android:id="@+id/dualDeleteGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="vertical">

        <!-- Option 1: Delete Download only -->
        <LinearLayout
            android:id="@+id/optDeleteDownload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_choice_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_download"
                app:tint="@color/md_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/delete_opt_download_title"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                    android:textColor="@color/md_on_surface"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/delete_opt_download_desc"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="@color/md_on_surface_variant" />
            </LinearLayout>
        </LinearLayout>

        <!-- Option 2: Delete Preview only -->
        <LinearLayout
            android:id="@+id/optDeletePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_choice_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_eye"
                app:tint="@color/md_tertiary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/delete_opt_preview_title"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                    android:textColor="@color/md_on_surface"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/delete_opt_preview_desc"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="@color/md_on_surface_variant" />
            </LinearLayout>
        </LinearLayout>

        <!-- Option 3: Delete BOTH -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteBoth"
            style="@style/Widget.GitHubUploader.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/delete_opt_both_btn"
            android:textSize="14sp"
            app:icon="@drawable/ic_trash"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="18dp" />
    </LinearLayout>

    <!-- Single confirm button (visible when confirming single-variant deletion) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmSingleDelete"
        style="@style/Widget.GitHubUploader.Button.Danger"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="@string/delete_release"
        android:textSize="14sp"
        android:visibility="gone"
        app:icon="@drawable/ic_trash"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconSize="18dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelDelete"
        style="@style/Widget.GitHubUploader.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:text="@string/cancel" />
</LinearLayout>
