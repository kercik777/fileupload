<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/branchRowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/bg_choice_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/ivBranchIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_branch"
        app:tint="@color/md_primary" />

    <TextView
        android:id="@+id/tvBranchName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
        android:textColor="@color/md_on_surface"
        android:textStyle="bold"
        tools:text="main" />

    <TextView
        android:id="@+id/tvBranchDefaultBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_thumb"
        android:paddingStart="7dp"
        android:paddingTop="2dp"
        android:paddingEnd="7dp"
        android:paddingBottom="2dp"
        android:text="@string/branch_default_badge"
        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
        android:textColor="@color/md_on_surface_variant"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvBranchSelectedBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_badge_active"
        android:paddingStart="7dp"
        android:paddingTop="2dp"
        android:paddingEnd="7dp"
        android:paddingBottom="2dp"
        android:text="@string/branch_selected_badge"
        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
        android:textColor="@color/md_on_primary"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDeleteBranch"
        style="@style/Widget.GitHubUploader.Button.Danger"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:contentDescription="@string/a11y_delete_branch"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:visibility="gone"
        app:icon="@drawable/ic_trash"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="16dp"
        tools:visibility="visible" />
</LinearLayout>
