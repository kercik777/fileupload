<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_surface"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_thumb"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_branch"
            app:tint="@color/md_primary" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/branch_dialog_title"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
        android:textColor="@color/md_on_surface"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvBranchRepoSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="@color/md_on_surface_variant"
        tools:text="Репозиторий: gitstorage1247/my-files" />

    <!-- Create new branch OR specify manual branch -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="@string/branch_input_hint"
        app:startIconDrawable="@drawable/ic_branch"
        app:startIconTint="@color/md_primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBranchNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateBranchNow"
            style="@style/Widget.GitHubUploader.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/branch_btn_create"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveManualBranch"
            style="@style/Widget.GitHubUploader.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/branch_btn_manual"
            app:icon="@drawable/ic_check"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="16dp" />
    </LinearLayout>

    <!-- Existing branches list header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/branch_list_header"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="@color/md_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefreshBranches"
            style="@style/Widget.GitHubUploader.Button.Text"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/history_refresh"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_refresh"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="18dp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBranches"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvBranchesEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/branch_empty"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="@color/md_on_surface_variant"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerBranches"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:layout_marginTop="4dp"
        android:overScrollMode="ifContentScrolls" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseBranchDialog"
        style="@style/Widget.GitHubUploader.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/close" />
</LinearLayout>
